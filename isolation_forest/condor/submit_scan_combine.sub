# HTCondor submit file — training-fraction scan, PHASE 3 (combine + evaluate).
#
# One job per fraction. Merges all per-run CSVs for that fraction's model into
# a single log, then evaluates → report → plots. Parameters come from
# condor/scan_combine_params.txt (generated by batch_submit.sh).
#
# Ordered after the apply phase by condor/scan.dag.

universe   = vanilla
executable = condor/run_scan.sh
arguments  = combine $(BASE_TAG)

initialdir = /afs/cern.ch/user/l/lbailloe/private/autoDQM/isolation_forest

output = condor/logs/scan_combine_$(BASE_TAG).$(Cluster).out
error  = condor/logs/scan_combine_$(BASE_TAG).$(Cluster).err
log    = /dev/null

# Combine + evaluate is single-threaded, but Pass 1 (merging all per-run CSVs
# into one log) plus Pass 2 (loads per-subrun data for up to max_subrun_plots
# categories) are memory-heavy and grow with data volume. History:
#   - 2026-07-18 (jobs 9413538.*): peaked ~7325 MB RSS; 3000 MB request was too
#     low, 4/5 procs held on "cgroup memory limit". Bumped to 10000 MB.
#   - 2026-07-20 (jobs 9416145.*): all 5 procs held, measured ~23950 MB — over
#     3x the earlier peak (larger merged logs), blowing past the 12000 MB cgroup
#     cap the 10000 MB request rounded up to. DAG aborted with no plots.
#   - 2026-07-23 (scan_train20_apply100): tried 80000 for the projected ~60 GB
#     100%-apply log, but at CERN a large request auto-scales RequestCpus (1 -> 32
#     at ~2.5 GB/core) and pins the job to the scarce "bigmcore" hostgroup (only
#     ~10 slots pool-wide) -> stuck Idle for hours, never matched. Reverted to
#     32000, which schedules on normal slots. If the 100% merged log OOMs at 32 GB,
#     shrink the footprint (lower max_subrun_plots) or apply to the good-run list
#     only (smaller log) — do NOT raise memory back into bigmcore territory.
request_cpus   = 1
request_memory = 32000

+JobFlavour = "workday"

should_transfer_files = NO
+ProjectName = "local"

notify_user  = lbailloe@cern.ch
notification = Error

queue BASE_TAG from condor/scan_combine_params.txt
