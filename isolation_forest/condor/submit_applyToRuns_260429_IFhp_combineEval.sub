# HTCondor submission file — autoDQM IFhp applyToRuns combine + evaluate
#
# 80 jobs: one per (config, quality) combination that has per-run CSV data.
# Each job independently combines its per-run CSVs and evaluates the result.
# The 28 models with no per-run data (training failed) are omitted.
#
# Writes:
#   logs/applyToRuns_260429_IFhp/<tag>.csv
#   reports/applyToRuns_260429_IFhp/<tag>/
#
# Submit from the isolation_forest/ directory:
#   condor_submit condor/submit_applyToRuns_260429_IFhp_combineEval.sub

universe   = vanilla
executable = condor/run_applyToRuns_260429_IFhp_combineEval.sh
arguments  = $(CONFIG) $(QUALITY)

initialdir = /afs/cern.ch/user/t/tafoyava/autoDQM/isolation_forest

output = /dev/null
error  = condor/logs/$(ClusterId).$(ProcId).err
log    = condor/logs/condor.log

request_cpus   = 1
request_memory = 2048

+JobFlavour = "workday"

should_transfer_files = NO
+ProjectName = "local"

notification = Never

queue CONFIG, QUALITY from (
  configs/config_ignoreDAQConfig__ifContamination_0p001__zThreshold_7sigma__nEst_200__maxSamp_1024.yaml, Loose
