# HTCondor submission file — autoDQM isolation-forest sweep 2026-04-29 EXT, apply-to-runs mode
#
# Single-model template: submit once per model via the wrapper script.
# CONFIG, VARIANT, QUALITY are passed on the condor_submit command line;
# each submission creates one cluster of 86 jobs (runs 1422–2276, 10 runs per job, 20 % each).
# Per-run logs are written to local scratch ($TMPDIR) inside each job to avoid
# continuous AFS writes; a single bulk copy to AFS happens at job exit.
#
# Do not submit this file directly — use the wrapper instead:
#   bash condor/submit_sweep_260429_EXT_applyToRuns_all.sh
#
# To submit a single model manually:
#   condor_submit -name bigbird11.cern.ch condor/submit_sweep_260429_EXT_applyToRuns.sub \
#       CONFIG=configs/config_ignoreDAQConfig__ifContamination_0p001__zThreshold_7sigma.yaml \
#       VARIANT=trigger_lvds \
#       QUALITY=Tight
#
# To combine all per-run logs for one model after its jobs finish:
#   python3 -m src.pipeline --config <cfg> --model-tag <tag>_260429_EXT \
#       --train-goodRunList --train-goodRunList-quality <Q> \
#       --logs-dir logs/applyToRuns_260429_EXT \
#       --combine-specific-run-outputs '*'

universe   = vanilla
executable = condor/run_sweep_260429_EXT_applyToRuns.sh
arguments  = $(CONFIG) $(VARIANT) $(QUALITY) $(Process)

initialdir = /afs/cern.ch/user/t/tafoyava/autoDQM/isolation_forest

output = /dev/null
error  = /dev/null
log    = /dev/null

request_cpus   = 1
request_memory = 2048

+JobFlavour = "workday"

should_transfer_files = NO
+ProjectName = "local"

#notify_user  = j.tafoya.vargas@cern.ch
#notification = Complete

queue 86
