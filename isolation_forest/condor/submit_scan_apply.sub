# HTCondor submit file — training-fraction scan, PHASE 2 (apply).
#
# One job per (fraction × run-group). Each job loads the already-trained model
# for its fraction (--skip-train) and applies it to every run in RUN_GROUP,
# writing logs/scan_trainFracSweep/<tag>_run<N>.csv. The same model is reused
# across all runs and all groups — nothing is retrained here.
#
# RUN_GROUP is a '+'-joined list of run numbers (commas are the column
# delimiter, so they cannot appear inside a field). Parameters come from
# condor/scan_apply_params.txt (generated by batch_submit.sh).
#
# Ordered after train and before combine by condor/scan.dag.

universe   = vanilla
executable = condor/run_scan.sh
arguments  = apply $(BASE_TAG) $(RUN_GROUP)

initialdir = /afs/cern.ch/user/l/lbailloe/private/autoDQM/isolation_forest

# RUN_GROUP is unsuitable for a filename (long, contains '+'); key on $(Process).
output = condor/logs/scan_apply_$(BASE_TAG)_p$(Process).$(Cluster).out
error  = condor/logs/scan_apply_$(BASE_TAG)_p$(Process).$(Cluster).err
log    = /dev/null

request_cpus   = 4
request_memory = 4096

+JobFlavour = "tomorrow"

should_transfer_files = NO
+ProjectName = "local"

notify_user  = lbailloe@cern.ch
notification = Error

queue BASE_TAG, RUN_GROUP from condor/scan_apply_params.txt
