# HTCondor submission file — autoDQM isolation-forest IF hyperparameter sweep 2026-04-29
#
# Sweeps n_estimators ∈ {200, 300, 500} × max_samples ∈ {256, 1024, 4096}
# at the best contamination/z region: contamination ∈ {0.001, 0.002}, z ∈ {7, 8}σ.
# Fixed at trigger+LVDS (trigger_lvds variant only) with triggerConfig enabled.
#
# 108 jobs:
#   2 contaminations × 2 z-thresholds × 3 n_estimators × 3 max_samples
#   × 1 variant (trigger_lvds)
#   × 3 goodRunsList quality selections (Loose, Medium, Tight)
#
# Submit from the isolation_forest/ directory:
#   condor_submit condor/submit_sweep_260429_IFhp.sub

universe   = vanilla
executable = condor/run_sweep_260429_IFhp.sh
arguments  = $(CONFIG) $(VARIANT) $(QUALITY)

initialdir = /afs/cern.ch/user/t/tafoyava/autoDQM/isolation_forest

output = /dev/null
error  = /dev/null
log    = /dev/null

request_cpus   = 4
request_memory = 4096

+JobFlavour = "workday"

should_transfer_files = NO
+ProjectName = "local"

notification = Never

