# HTCondor submit file — training-fraction scan, PHASE 1 (train).
#
# One job per training fraction. Each trains a single IsolationForest on the
# Tight good-run list and saves it under models/<BASE_TAG>_Tight/.
# Parameters come from condor/scan_train_params.txt (generated by batch_submit.sh).
#
# Ordered before the apply phase by condor/scan.dag — do not submit directly;
# run batch_submit.sh, which submits the whole DAG.

universe   = vanilla
executable = condor/run_scan.sh
arguments  = train $(BASE_TAG) $(TRAINFRAC)

initialdir = /afs/cern.ch/user/l/lbailloe/private/autoDQM/isolation_forest

output = condor/logs/scan_train_$(BASE_TAG).$(Cluster).out
error  = condor/logs/scan_train_$(BASE_TAG).$(Cluster).err
log    = /dev/null

request_cpus   = 4
request_memory = 4096

+JobFlavour = "tomorrow"

should_transfer_files = NO
+ProjectName = "local"

notify_user  = lbailloe@cern.ch
notification = Error

queue BASE_TAG, TRAINFRAC from condor/scan_train_params.txt
